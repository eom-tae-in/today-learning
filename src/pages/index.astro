---
import RecordCard from "../components/RecordCard.astro";
import RecordGraph from "../components/RecordGraph.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
    getAllTags,
    getAvailableYears,
    getLearningRecords,
    getRecordHref,
    getTagHref,
} from "../lib/records";

const records = await getLearningRecords();
const years = getAvailableYears(records);
const tags = getAllTags(records);
const latest = records[0];
const reviewedCount = records.filter((record) => record.status === "reviewed").length;
const title = "Today Learning";
const description = "TLP, TIL, AI 학습 정리를 Markdown 기반 노트로 모아보는 개인 학습 블로그입니다.";
---

<BaseLayout title={title} description={description}>
    <section class="hero">
        <div class="hero-copy">
            <span class="eyebrow">Markdown learning notebook</span>
            <h1>매일의 기록을 다시 읽기 좋은 노트로.</h1>
            <p>
                TLP로 계획하고, TIL로 회고하고, AI 정리로 학습 흐름을 다시 확인합니다.
                Markdown, 이미지, GIF, Mermaid 다이어그램까지 글 안에서 자연스럽게 다룹니다.
            </p>
            <div class="hero-actions">
                <a class="button primary" href="#records">기록 보기</a>
                {latest !== undefined && <a class="button secondary" href={getRecordHref(latest.date)}>최근 기록</a>}
            </div>
        </div>
        <aside class="hero-panel" aria-label="학습 기록 요약">
            <span>현재 노트</span>
            <strong>{records.length}</strong>
            <p>{reviewedCount}개의 AI 학습 정리가 연결되어 있습니다.</p>
        </aside>
    </section>

    <RecordGraph records={records} />

    <section id="records" class="section records-section" aria-labelledby="records-title">
        <div class="section-heading split">
            <div>
                <span class="eyebrow">Records</span>
                <h2 id="records-title">학습 기록</h2>
                <p>검색어와 연도로 계획, 회고, AI 정리를 빠르게 찾습니다.</p>
            </div>
            <div class="record-controls" data-record-controls>
                <label>
                    <span class="sr-only">기록 검색</span>
                    <input type="search" data-record-search placeholder="제목, 요약, 태그 검색" />
                </label>
                <select data-year-filter aria-label="연도 필터">
                    <option value="all">전체 연도</option>
                    {years.map((year) => <option value={year}>{year}</option>)}
                </select>
            </div>
        </div>

        <div class="tag-cloud" aria-label="전체 태그">
            {tags.map((tag) => <a href={getTagHref(tag)}>{tag}</a>)}
        </div>

        <div class="records-grid" data-record-list>
            {records.map((record) => <RecordCard record={record} />)}
        </div>
        <p class="empty-results" data-empty-results hidden>조건에 맞는 기록이 없습니다.</p>
    </section>
</BaseLayout>
