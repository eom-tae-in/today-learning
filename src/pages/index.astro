---
import RecordCard from "../components/RecordCard.astro";
import RecordGraph from "../components/RecordGraph.astro";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { baseUrl as base } from "../lib/paths";
import { getLearningRecords } from "../lib/records";
const records = await getLearningRecords();
const recentRecords = records.slice(0, 6);
---
<BaseLayout glow>
    <section class="hero">
        <div class="hero-copy">
            <span class="hero-badge"><i aria-hidden="true"></i>매일의 배움을 기록하다</span>
            <h1>배우고,<span>기록하고,</span>연결한다.</h1>
            <p>매일 배운 내용을 TIL로 남깁니다. 쉬운 요약으로 전체 흐름을 먼저 읽고, 원문에서 개념과 구현 과정을 자세히 살펴보세요.</p>
            <div class="hero-actions"><a class="button primary" href="#records">학습 기록 보기<Icon name="chevron" /></a><a class="button ghost" href="#graph">학습 로그 보기</a></div>
        </div>
        <aside class="hero-note" aria-label="Today Learning 기록 원칙">
            <div class="note-top"><i class="window-dot red"></i><i class="window-dot yellow"></i><i class="window-dot green"></i><span>daily.md</span></div>
            <div class="note-content"><p class="note-path">~/today-learning/daily.md</p>
                <p class="code-line"><span>01</span><strong>Learn</strong><span>오늘의 배움을 발견하고</span></p>
                <p class="code-line highlighted"><span>02</span><strong>TIL</strong><span>배운 내용을 기록하고</span></p>
                <p class="code-line"><span>03</span><strong>Read</strong><span>요약과 원문으로 다시 읽는다.</span></p>
                <div class="note-footer"><span>LEARN</span><span>WRITE</span><span>READ</span></div>
            </div>
        </aside>
    </section>
    <RecordGraph records={records} />
    <section id="records" class="section records-section" aria-labelledby="records-title">
        <div class="section-heading"><span class="eyebrow">Records</span><h2 id="records-title">학습 기록</h2><p>최근 기록 {recentRecords.length}개예요. 검색과 태그 필터는 전체 기록에서 쓸 수 있어요.</p></div>
        <div class="records-grid">{recentRecords.map(record => <RecordCard record={record} />)}</div>
        <div class="records-more"><a class="button secondary" href={base + "records/"}>전체 기록 보기<Icon name="chevron" /></a></div>
    </section>
</BaseLayout>
