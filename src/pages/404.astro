---
import BaseLayout from "../layouts/BaseLayout.astro";
import { baseUrl as base } from "../lib/paths";
---
<BaseLayout title="페이지를 찾을 수 없어요 | Today Learning" noindex>
    <section class="section not-found" aria-labelledby="not-found-title">
        <span class="eyebrow">404</span>
        <h1 id="not-found-title">페이지를 찾을 수 없어요</h1>
        <p>주소가 바뀌었거나 아직 없는 기록이에요.</p>
        <div class="not-found-actions"><a class="button primary" href={base}>홈으로</a><a class="button secondary" href={base + "records/"}>기록 목록 보기</a></div>
    </section>
</BaseLayout>
