---
import RecordCard from "../../components/RecordCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllTags, getLearningRecords, getTagSlug } from "../../lib/records";

export async function getStaticPaths() {
    const records = await getLearningRecords();

    return getAllTags(records).map((tag) => ({
        params: { tag: getTagSlug(tag) },
        props: { tag },
    }));
}

type Props = {
    readonly tag: string;
};

const { tag } = Astro.props;

if (tag === undefined) {
    return Astro.redirect("/");
}

const records = (await getLearningRecords()).filter((record) => record.tags.includes(tag));
const title = `${tag} 기록 | Today Learning`;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={title} description={`${tag} 태그가 연결된 학습 기록입니다.`}>
    <section class="section tag-page">
        <a class="back-link" href={baseUrl}>기록 목록으로</a>
        <div class="section-heading">
            <span class="eyebrow">Tag</span>
            <h1>{tag}</h1>
            <p>{records.length}개의 기록이 연결되어 있습니다.</p>
        </div>
        <div class="records-grid">
            {records.map((record) => <RecordCard record={record} />)}
        </div>
    </section>
</BaseLayout>
