---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecordsList from "../../components/RecordsList.astro";
import { getAllTags, getLearningRecords, getTagSlug } from "../../lib/records";
export async function getStaticPaths() {
    return getAllTags(await getLearningRecords()).map(tag => ({ params: { tag: getTagSlug(tag) }, props: { tag } }));
}
type Props = { readonly tag: string };
const { tag } = Astro.props;
const records = await getLearningRecords();
---
<BaseLayout title={tag + " 기록 | Today Learning"} description={tag + " 태그가 연결된 학습 기록입니다."}>
    <RecordsList records={records} selectedTag={tag} />
</BaseLayout>
