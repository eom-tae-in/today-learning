---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { baseUrl as base } from "../lib/paths";
type Props = { readonly title?: string; readonly description?: string; readonly glow?: boolean };
const { title = "Today Learning", description = "매일의 학습 내용을 TIL 원문과 쉬운 요약으로 읽는 개인 학습 노트입니다.", glow = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
<head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} /><meta name="theme-color" content="#F4F8FB" data-theme-color />
    <script is:inline>
        (() => {
            let saved = null;
            try { saved = localStorage.getItem("today-learning-theme"); } catch (error) { if (!(error instanceof DOMException)) throw error; }
            const theme = ["light", "dark", "green"].includes(saved) ? saved : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            document.documentElement.dataset.theme = theme;
            document.querySelector("[data-theme-color]").content = { light: "#F4F8FB", dark: "#121417", green: "#EEF2EA" }[theme];
        })();
    </script>
    <link rel="canonical" href={canonicalUrl} /><link rel="icon" href={base + "favicon.svg"} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonicalUrl} /><title>{title}</title>
</head>
<body class:list={[{ "has-glow": glow }]}>
    <a class="skip-link" href="#main-content">본문으로 바로가기</a>
    <div class="page-background" aria-hidden="true"></div>
    <header class="site-header"><nav class="site-nav" aria-label="주요 메뉴">
        <a class="brand" href={base}><span class="brand-mark" aria-hidden="true">T</span><span><strong>Today Learning</strong><small>Daily Growth Notes</small></span></a>
        <div class="nav-actions">
            <a class="header-menu" href={base + "#graph"}>학습 로그</a><a class="header-menu" href={base + "records/"}>학습 기록</a><span class="nav-separator" aria-hidden="true"></span>
            <a class="header-link" href="https://github.com/eom-tae-in/today-learning" target="_blank" rel="noreferrer"><Icon name="github" />Repository</a>
            <div class="theme-switch" role="radiogroup" aria-label="색 테마">
                {([["light", "Light 밝은 테마", "sun"], ["dark", "Dark 어두운 테마", "moon"], ["green", "Green 읽기 테마", "leaf"]] as const).map(([theme, label, icon]) =>
                    <button type="button" role="radio" aria-label={label} aria-checked={theme === "light" ? "true" : "false"} data-theme-option={theme}><Icon name={icon} /></button>)}
            </div>
        </div>
    </nav></header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer"><div class="footer-content">
        <div><strong>Today Learning</strong><p>매일의 배움을 기록하고, 흐름을 이해하고, 다시 읽습니다.</p></div>
        <nav aria-label="푸터 메뉴"><a href={base + "#graph"}>학습 로그</a><a href={base + "records/"}>학습 기록</a><a href="https://github.com/eom-tae-in/today-learning" target="_blank" rel="noreferrer">GitHub</a></nav>
    </div></footer>
    <script>import "../scripts/site.ts";</script>
</body>
</html>
