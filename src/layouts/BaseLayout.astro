---
import "../styles/global.css";

type Props = {
    readonly title?: string;
    readonly description?: string;
};

const {
    title = "Today Learning",
    description = "TLP로 하루를 계획하고, TIL로 학습과 회고를 기록하는 개인 학습 노트입니다.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="ko">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f5f6fa" data-theme-color />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="icon" href={`${baseUrl}favicon.svg`} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
        />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <title>{title}</title>
    </head>
    <body>
        <a class="skip-link" href="#main-content">본문으로 바로가기</a>
        <div class="page-background" aria-hidden="true"></div>
        <header class="site-header">
            <nav class="site-nav" aria-label="주요 메뉴">
                <a class="brand" href={baseUrl}>
                    <span class="brand-mark" aria-hidden="true">T</span>
                    <span>
                        <strong>Today Learning</strong>
                        <small>Daily Growth Notes</small>
                    </span>
                </a>
                <div class="nav-actions">
                    <a class="header-link" href="https://github.com/eom-tae-in/today-learning" target="_blank" rel="noreferrer">
                        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
                            <path
                                fill="currentColor"
                                d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.27-1.22-1.6-1.22-1.6-.99-.68.08-.67.08-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.67 2.56 1.19 3.18.91.1-.71.38-1.19.7-1.46-2.47-.28-5.08-1.23-5.08-5.5 0-1.21.43-2.2 1.14-2.98-.12-.28-.5-1.41.1-2.94 0 0 .94-.3 3.07 1.14A10.6 10.6 0 0 1 12 6.3c.95 0 1.91.13 2.8.38 2.12-1.44 3.06-1.14 3.06-1.14.6 1.53.22 2.66.1 2.94.72.78 1.14 1.77 1.14 2.98 0 4.28-2.61 5.21-5.1 5.49.4.35.76 1.03.76 2.08v3.06c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"
                            />
                        </svg>
                        <span>Repository</span>
                    </a>
                    <button
                        class="theme-toggle"
                        type="button"
                        data-theme-toggle
                        aria-label="테마 변경"
                        aria-pressed="false"
                    >
                        <span class="theme-toggle-sky" aria-hidden="true"></span>
                        <svg class="theme-icon theme-icon-sun" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
                            <path
                                fill="none"
                                stroke="currentColor"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2.2"
                                d="M12 7.3a4.7 4.7 0 1 1 0 9.4 4.7 4.7 0 0 1 0-9.4ZM12 2.3v2.1m0 15.2v2.1M4.4 4.4l1.5 1.5m12.2 12.2 1.5 1.5M2.3 12h2.1m15.2 0h2.1M4.4 19.6l1.5-1.5M18.1 5.9l1.5-1.5"
                            />
                        </svg>
                        <svg class="theme-icon theme-icon-moon" aria-hidden="true" viewBox="0 0 24 24" width="19" height="19">
                            <path fill="currentColor" d="M20.2 15.1A8.6 8.6 0 0 1 8.9 3.8a8.9 8.9 0 1 0 11.3 11.3Z" />
                        </svg>
                    </button>
                </div>
            </nav>
        </header>
        <main id="main-content">
            <slot />
        </main>
        <footer class="site-footer">
            <div>
                <strong>Today Learning</strong>
                <p>매일의 계획, 학습, 회고를 오래 읽을 수 있는 노트로 남깁니다.</p>
            </div>
        </footer>
        <script>
            import "../scripts/site.ts";
        </script>
    </body>
</html>
