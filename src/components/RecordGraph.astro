---
import { getRecordHref, type LearningRecord } from "../lib/records";

type Props = { readonly records: readonly LearningRecord[] };
const { records } = Astro.props;
const today = new Date().toLocaleDateString("en-CA", { timeZone: "Asia/Seoul" });
const years = Array.from(new Set(records.map((record) => record.year))).toSorted(
    (left, right) => right.localeCompare(left)
);
const newestYear = years[0] ?? new Date().getFullYear().toString();
const displayYears = years.length > 0 ? years : [newestYear];
const byDate = new Map(records.map((record) => [record.date, record]));
const monthLabels = ["1월", "2월", "3월", "4월", "5월", "6월", "7월", "8월", "9월", "10월", "11월", "12월"];

function getYearCalendar(year: string) {
    const start = Date.UTC(Number(year), 0, 1);
    const end = Date.UTC(Number(year) + 1, 0, 1);
    const offset = new Date(start).getUTCDay();
    const days = Array.from({ length: (end - start) / 86400000 }, (_, index) => {
        const date = new Date(start + index * 86400000).toISOString().slice(0, 10);
        return { date, record: byDate.get(date) };
    });
    const months = monthLabels.map((label, month) => ({
        label,
        column: Math.floor(((Date.UTC(Number(year), month, 1) - start) / 86400000 + offset) / 7) + 1,
    }));
    return { days, months, offset };
}
---

<section id="graph" class="section graph-section" aria-labelledby="graph-title">
    <div class="learning-board">
        <div class="learning-board-header">
            <div>
                <span class="eyebrow">Learning log</span>
                <h2 id="graph-title">학습의 기록</h2>
                <p>TIL을 남긴 날을 확인하고, 날짜를 눌러 기록을 읽어보세요.</p>
            </div>
        </div>
        <div class="graph-layout">
            <div class="graph-panel">
                {displayYears.map((year) => {
                    const calendar = getYearCalendar(year);
                    return (
                        <div class="graph-scroll" data-graph-year={year} hidden={year !== newestYear}>
                            <div class="calendar" aria-label={`${year}년 TIL 기록 달력`}>
                                <div class="graph-months" aria-hidden="true">
                                    {calendar.months.map(({ label, column }) => <span style={`grid-column: ${column}`}>{label}</span>)}
                                </div>
                                <div class="graph-weekdays" aria-hidden="true">
                                    <span>월</span><span>수</span><span>금</span>
                                </div>
                                <div class="graph-grid">
                                    {Array.from({ length: calendar.offset }, () => <span class="graph-spacer" aria-hidden="true" />)}
                                    {calendar.days.map(({ date, record }) => record === undefined ? (
                                        <span class:list={["graph-cell", { "is-today": date === today }]} data-calendar-date={date} title={`${date} · TIL 없음`} aria-label={`${date} · TIL 없음`} />
                                    ) : (
                                        <a
                                            class:list={["graph-cell has-record", { "is-today": date === today }]}
                                            data-calendar-date={date}
                                            data-record-date={date}
                                            href={getRecordHref(date)}
                                            title={`${date} · ${record.title}`}
                                            aria-label={`${date} · ${record.title} 읽기`}
                                        />
                                    ))}
                                </div>
                            </div>
                        </div>
                    );
                })}
                <p class="graph-hint">← 좌우로 밀어 1년 전체 보기</p>
                <div class="graph-meta">
                    <div class="graph-legend" aria-label="기록 범례">
                        <span><i class="graph-cell" aria-hidden="true"></i>TIL 없음</span>
                        <span><i class="graph-cell has-record" aria-hidden="true"></i>TIL 있음</span>
                        <span><i class="graph-cell is-today" aria-hidden="true"></i>오늘</span>
                    </div>
                </div>
            </div>
            <nav class="graph-year-rail" aria-label="기록 연도">
                {displayYears.map((year) => (
                    <button type="button" data-graph-year-option={year}
                        aria-pressed={year === newestYear ? "true" : "false"}>{year}</button>
                ))}
            </nav>
        </div>
    </div>
</section>
