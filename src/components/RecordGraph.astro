---
import { getRecordHref, type LearningRecord } from "../lib/records";

type Props = {
    readonly records: readonly LearningRecord[];
};

const { records } = Astro.props;
const newestYear = records[0]?.year ?? new Date().getFullYear().toString();
const years = Array.from(new Set(records.map((record) => record.year))).toSorted(
    (left, right) => right.localeCompare(left)
);
const recordsByYear = new Map(
    years.map((year) => [
        year,
        new Map(records.filter((record) => record.year === year).map((record) => [record.date, record])),
    ])
);
function formatDateKey(date: Date): string {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");

    return `${year}-${month}-${day}`;
}

function getYearDays(year: string) {
    const firstDate = new Date(Number(year), 0, 1);
    const lastDate = new Date(Number(year), 11, 31);
    const recordByDate = recordsByYear.get(year) ?? new Map();
    const days = [];

    for (
        const date = new Date(firstDate);
        date <= lastDate;
        date.setDate(date.getDate() + 1)
    ) {
        const dateKey = formatDateKey(date);
        const record = recordByDate.get(dateKey);

        days.push({
            date: dateKey,
            day: date.getDay(),
            record,
        });
    }

    return days;
}
---

<section id="graph" class="section graph-section" aria-labelledby="graph-title">
    <div class="learning-board" data-learning-board>
        <div class="learning-board-header">
            <div>
                <span class="eyebrow">Learning log</span>
                <h2 id="graph-title">학습의 기록</h2>
                <p>기록이 남은 날을 선택해 그날의 계획, 회고, AI 정리 상태를 바로 확인합니다.</p>
            </div>
        </div>

        <div class="graph-layout">
            <div class="graph-panel">
                <label class="sr-only" for="graph-year-select">그래프 연도 선택</label>
                <select id="graph-year-select" data-graph-year-select hidden>
                    {
                        years.map((year) => (
                            <option value={year}>{year}</option>
                        ))
                    }
                </select>
                {
                    years.map((year) => (
                        <div
                            class="graph-scroll"
                            data-graph-year={year}
                            hidden={year !== newestYear}
                            aria-label={`${year}년 학습 기록 그래프`}
                        >
                            <div class="graph-grid">
                                {
                                    getYearDays(year).map(({ date, day, record }) => (
                                        record === undefined ? (
                                            <span
                                                class="graph-cell"
                                                data-day={day}
                                                title={`${date} 기록 없음`}
                                                aria-label={`${date} 기록 없음`}
                                            />
                                        ) : (
                                            <a
                                                class={`graph-cell has-record level-${record.completionLevel}`}
                                                role="button"
                                                aria-pressed="false"
                                                data-day={day}
                                                data-record-year={year}
                                                data-graph-record
                                                data-title={record.title}
                                                data-date={record.displayDate}
                                                data-record-date={record.date}
                                                data-summary={record.summary}
                                                data-status={record.statusLabel}
                                                data-level={record.completionLabel}
                                                data-initial-record={record.date === records[0]?.date ? "true" : "false"}
                                                href={getRecordHref(record.date)}
                                                title={`${record.displayDate} ${record.title}`}
                                                aria-label={`${record.displayDate} ${record.title}`}
                                                style={`--level-color: ${record.completionColor}`}
                                            />
                                        )
                                    ))
                                }
                            </div>
                        </div>
                    ))
                }
                <div class="graph-meta">
                    <span data-graph-current-year>{newestYear}년</span>
                    <div class="graph-legend" aria-label="그래프 범례">
                        <span><i class="graph-cell level-excellent" aria-hidden="true"></i>매우 좋음</span>
                        <span><i class="graph-cell level-good" aria-hidden="true"></i>좋음</span>
                        <span><i class="graph-cell level-needs-work" aria-hidden="true"></i>보완 필요</span>
                        <span><i class="graph-cell level-not-evaluated" aria-hidden="true"></i>평가 미진행</span>
                    </div>
                </div>
            </div>
            <nav class="graph-year-rail" aria-label="학습 그래프 연도">
                {
                    years.map((year) => (
                        <button
                            type="button"
                            data-graph-year-option={year}
                            aria-pressed={year === newestYear ? "true" : "false"}
                        >
                            {year}
                        </button>
                    ))
                }
            </nav>
        </div>
        <aside class="graph-preview" data-graph-preview>
            <span>AI 평가</span>
            <strong data-graph-preview-title>기록된 날짜를 선택해 주세요.</strong>
            <p data-graph-preview-summary>잔디 칸을 선택하면 그날의 요약과 AI 평가를 이곳에서 확인합니다.</p>
            <dl data-graph-preview-meta hidden>
                <div>
                    <dt>날짜</dt>
                    <dd data-graph-preview-date>기록 선택</dd>
                </div>
                <div>
                    <dt>AI 평가</dt>
                    <dd data-graph-preview-status>대기 중</dd>
                </div>
            </dl>
            <a class="graph-preview-link" data-graph-preview-link href={records[0] === undefined ? "#" : getRecordHref(records[0].date)}>
                기록 열기
            </a>
        </aside>
    </div>
</section>
