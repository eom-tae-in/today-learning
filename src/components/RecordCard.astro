---
import { getRecordHref, getTagHref, type LearningRecord } from "../lib/records";
import Icon from "./Icon.astro";

type Props = {
    readonly record: LearningRecord;
    readonly showTags?: boolean;
};

const { record, showTags = true } = Astro.props;
---

<article
    class="record-card"
    data-record-card
    data-year={record.year}
    data-date={record.date}
    data-tags={JSON.stringify(record.tags)}
    data-search={`${record.title} ${record.summary} ${record.tags.join(" ")}`.toLowerCase()}
>
    <a class="record-link" href={getRecordHref(record.date)}>
        <span class="record-date">{record.displayDate}</span>
        <h3>{record.title}</h3>
        <p>{record.summary}</p>
    </a>
    {showTags && record.tags.length > 0 && (
        <div class="tag-list" aria-label="태그">
            {record.tags.map((tag) => <a href={getTagHref(tag)}>{tag}</a>)}
        </div>
    )}
    <div class="record-card-footer" aria-hidden="true"><span>요약 · 원문 보기</span><Icon name="forward" /></div>
</article>
