---
import {
    getRecordHref,
    getTagHref,
    type LearningRecord,
} from "../lib/records";

type Props = {
    readonly record: LearningRecord;
    readonly showTags?: boolean;
};

const { record, showTags = true } = Astro.props;
---

<article
    class={`record-card level-${record.completionLevel}`}
    data-record-card
    data-year={record.year}
    data-level={record.completionLevel}
    data-search={`${record.title} ${record.summary} ${record.tags.join(" ")}`.toLowerCase()}
    style={`--level-color: ${record.completionColor}`}
>
    <a href={getRecordHref(record.date)}>
        <span class="record-date">{record.displayDate}</span>
        <h3>{record.title}</h3>
        <p>{record.summary}</p>
        <span class="record-status" style={`--level-color: ${record.completionColor}`}>
            <span aria-hidden="true"></span>
            {record.statusLabel}
        </span>
    </a>
    {
        showTags && record.tags.length > 0 && (
            <div class="tag-list" aria-label="태그" data-card-tags hidden>
                {record.tags.map((tag) => (
                    <a href={getTagHref(tag)} data-card-tag-value={tag.toLowerCase()} hidden>{tag}</a>
                ))}
            </div>
        )
    }
</article>
