---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
type Props = { readonly entry: CollectionEntry<"record"> | undefined };
const { entry } = Astro.props;
const rendered = entry === undefined ? undefined : await render(entry);
const Content = rendered?.Content;
---
<section id="til" class="reader-body" aria-label="TIL 원문">
    {Content ? <div class="markdown-body"><Content /></div> : <p>이 날짜의 TIL 원문을 찾을 수 없습니다.</p>}
</section>
