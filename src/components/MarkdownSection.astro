---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
type Props = { readonly entry: CollectionEntry<"record"> | undefined };
const { entry } = Astro.props;
const rendered = entry === undefined ? undefined : await render(entry);
const Content = rendered?.Content;
---
<section id="til" class="reader-block reader-block-til" data-reader-panel="til" aria-label="TIL 원문">
    {Content ? <div class="reader-content-grid"><div class="original-column"><div class="markdown-body"><Content /></div><slot /></div><aside class="markdown-toc" id="reading-toc"><span>목차</span><nav data-desktop-toc aria-label="원문 목차"></nav></aside></div> : <p>이 날짜의 TIL 원문을 찾을 수 없습니다.</p>}
</section>
